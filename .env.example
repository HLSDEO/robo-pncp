POSTGRES_USER=pncp
POSTGRES_PASSWORD=pncp
POSTGRES_DB=pncp
POSTGRES_PORT=5432

# loop = roda continuo a cada LOOP_INTERVAL_SECONDS
# once = uma rodada e sai
RUN_MODE=loop
LOOP_INTERVAL_SECONDS=21600

PAGE_SIZE=50
HTTP_TIMEOUT=60
LOG_LEVEL=INFO

# Numero de threads concorrentes para coletar unidades/editais/contratos.
# Pool de conexoes do Postgres usa (WORKERS + 2).
WORKERS=4

# ----- Dados Abertos Comprasgov -----
# tamanhoPagina aceito pela API: 10..500
DA_PAGE_SIZE=500
# Coletar catalogo completo de itens de material (~342k). false = so Grupo/Classe/PDM.
DA_MATERIAL_ITENS=true
# Ano inicial para varrer ARPs (janelas de 365 dias ate hoje+1ano).
ARP_ANO_INICIAL=2023

# ----- Observabilidade -----
OBS_ENABLED=true
OBS_URL=http://backend:8000/api/logs
OBS_SOURCE=robo-pncp
OBS_ENVIRONMENT=prod
OBS_TIMEOUT=5
OBS_QUEUE_MAX=5000
