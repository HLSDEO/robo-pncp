POSTGRES_USER=pncp
POSTGRES_PASSWORD=pncp
POSTGRES_DB=pncp
POSTGRES_PORT=5432

# loop = roda continuo a cada LOOP_INTERVAL_SECONDS
# once = uma rodada e sai
RUN_MODE=loop
LOOP_INTERVAL_SECONDS=21600

PAGE_SIZE=50
HTTP_TIMEOUT=60
LOG_LEVEL=INFO

# ----- Observabilidade -----
# Aponta para o backend do projeto C:\Git\observabilidade.
# Quando os dois containers estao na mesma rede docker (observabilidade_network),
# basta usar o hostname do servico (backend) na porta interna (8000).
OBS_ENABLED=true
OBS_URL=http://backend:8000/api/logs
OBS_SOURCE=robo-pncp
OBS_ENVIRONMENT=prod
OBS_TIMEOUT=5
OBS_QUEUE_MAX=5000
