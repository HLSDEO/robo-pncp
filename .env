POSTGRES_USER=pncp
POSTGRES_PASSWORD=pncp
POSTGRES_DB=pncp
POSTGRES_PORT=5442

# Adminer (UI web para o Postgres) - http://localhost:${ADMINER_PORT}
ADMINER_PORT=8100

# loop = roda continuo a cada LOOP_INTERVAL_SECONDS
# once = uma rodada e sai
RUN_MODE=loop
LOOP_INTERVAL_SECONDS=21600

PAGE_SIZE=50
HTTP_TIMEOUT=60
HTTP_CONNECT_TIMEOUT=10
LOG_LEVEL=INFO

# Numero de threads concorrentes para coletar unidades/editais.
# Pool de conexoes do Postgres usa (WORKERS + 2).
# >>> Se o PNCP continuar derrubando conexao (Connection refused), BAIXE para 2.
WORKERS=3

# ----- Retry / resiliencia HTTP (PNCP rate-limita em rajadas) -----
HTTP_RETRIES=6
HTTP_BACKOFF_MAX=60
HTTP_MAX_CONNECTIONS=10
HTTP_MAX_KEEPALIVE=5
HTTP_KEEPALIVE_EXPIRY=5

# ----- Dados Abertos Comprasgov -----
# tamanhoPagina aceito pela API: 10..500
DA_PAGE_SIZE=500
# Ano inicial para varrer ARPs (janelas de 365 dias ate hoje+1ano).
ARP_ANO_INICIAL=2023
# Rate limit (HTTP 429): pausa global do host pelo tempo pedido + buffer.
DA_RATELIMIT_BUFFER=1
DA_RATELIMIT_DEFAULT_WAIT=3
DA_RATELIMIT_MAX_WAIT=60
DA_RATELIMIT_MAX_PAUSES=100

# ----- Observabilidade -----
OBS_ENABLED=true
OBS_URL=http://backend:8000/api/logs
OBS_SOURCE=robo-pncp
OBS_ENVIRONMENT=prod
OBS_TIMEOUT=5
OBS_QUEUE_MAX=5000
